# App
NEXT_PUBLIC_APP_NAME=小谷
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
APP_ENV=development
ENABLE_DEMO_MODE=false

# Required for commercial mode. Set ENABLE_DEMO_MODE=true only for local demos.
MODEL_PROVIDER=groq
MODEL_API_BASE=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_REQUEST_TIMEOUT_MS=500000
IMAGE_GENERATION_BUDGET_MS=500000

# Groq: OpenAI-compatible, recommended low-friction setup.
# MODEL_PROVIDER=groq
# GROQ_API_KEY=
# MODEL_NAME=llama-3.3-70b-versatile

# Google AI Studio / Gemini.
# MODEL_PROVIDER=google
# GOOGLE_API_KEY=
# MODEL_API_BASE=https://generativelanguage.googleapis.com/v1beta
# MODEL_NAME=gemini-2.5-flash

# Topic discovery
DAILY_HOT_API_BASE=https://dailyhot.imsyy.top
SEARCH_API_KEY=
SEARCH_API_BASE=
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com/search
TOPIC_SEARCH_ENRICH_LIMIT=8
JINA_API_KEY=
JINA_TIMEOUT_MS=7000
TOPIC_REFRESH_SECRET=replace-with-a-long-random-secret

# Billing
OPENMETER_BASE_URL=http://localhost:8888
OPENMETER_API_KEY=
OPENMETER_NAMESPACE=insurance-content-agent
OPENMETER_FEATURE_KEY=ai_content_generation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production database placeholders
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_content_agent
REDIS_URL=redis://localhost:6379
# Optional authorized provider. The provider must return data items with authorized=true.
AUTHORIZED_SHORT_VIDEO_API_BASE=
