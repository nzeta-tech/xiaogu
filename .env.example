# App
NEXT_PUBLIC_APP_NAME=小谷
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
APP_ENV=development
ENABLE_DEMO_MODE=false

# Required for commercial mode. Set ENABLE_DEMO_MODE=true only for local demos.
MODEL_PROVIDER=groq
MODEL_API_BASE=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_REQUEST_TIMEOUT_MS=500000
IMAGE_GENERATION_BUDGET_MS=500000

# Groq: OpenAI-compatible, recommended low-friction setup.
# MODEL_PROVIDER=groq
# GROQ_API_KEY=
# MODEL_NAME=llama-3.3-70b-versatile

# Google AI Studio / Gemini.
# MODEL_PROVIDER=google
# GOOGLE_API_KEY=
# MODEL_API_BASE=https://generativelanguage.googleapis.com/v1beta
# MODEL_NAME=gemini-2.5-flash

# Topic discovery
DAILY_HOT_API_BASE=https://dailyhot.imsyy.top
SEARCH_API_KEY=
SEARCH_API_BASE=
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com/search
TOPIC_SEARCH_ENRICH_LIMIT=8
VIRAL_SEARCH_BROWSER_ENABLED=1
VIRAL_SEARCH_CDP_URL=http://127.0.0.1:9224
VIRAL_SEARCH_BROWSER_TIMEOUT_MS=12000
VIRAL_EXAMPLES_TIMEOUT_MS=12000
# Standalone viral data worker. It prepares data asynchronously and atomically
# publishes the final snapshot to PostgreSQL; user requests never trigger collection.
VIRAL_PREPARATION_SECRET=replace-with-a-long-random-secret
VIRAL_PREPARATION_INTERVAL_MS=21600000
VIRAL_PREPARATION_TIMEOUT_MS=300000
VIRAL_PREPARED_DATA_MAX_AGE_MS=108000000
# Author discovery is not capped by the three-item publication limit. Refresh
# a bounded batch of discovered profile pages and keep the rest queued.
VIRAL_CREATOR_PROFILE_REFRESH_ENABLED=1
VIRAL_CREATOR_REFRESH_MAX_ACCOUNTS=8
VIRAL_CREATOR_REFRESH_BROWSER_ACCOUNTS=3
VIRAL_CREATOR_REFRESH_MAX_WORKS=10
VIRAL_CREATOR_TARGET_PER_PLATFORM=100
VIRAL_CREATOR_DISCOVERY_INTERVAL_MS=86400000
VIRAL_CREATOR_DISCOVERY_TIMEOUT_MS=300000
# Optional comma-separated override. Defaults cover insurance, claims, health
# disclosure, retirement, asset allocation, funds and household finance.
VIRAL_CREATOR_DISCOVERY_QUERIES=
VIRAL_SOGOU_ACCOUNT_SEARCH_MAX_PAGES=2
VIRAL_WECHAT_MP_DISCOVERY_ENABLED=1
VIRAL_WECHAT_MP_CDP_URL=http://127.0.0.1:9226
VIRAL_WECHAT_MP_SEARCH_TIMEOUT_MS=12000
JINA_API_KEY=
JINA_TIMEOUT_MS=7000
TOPIC_REFRESH_SECRET=replace-with-a-long-random-secret

# Public source inspection
# AWS Web: enable task delegation and configure the shared, high-entropy token.
LOCAL_AGENT_ENABLED=0
LOCAL_AGENT_TOKEN=replace-with-a-long-random-agent-token
# Local computer only: public AWS/ALB URL used to lease and complete tasks.
# LOCAL_AGENT_BASE_URL=https://your-xiaogu-domain.example
LOCAL_AGENT_ID=xiaogu-local
LOCAL_AGENT_CAPABILITIES=source.inspect
LOCAL_AGENT_POLL_INTERVAL_MS=3000
LOCAL_AGENT_LEASE_SECONDS=600
LOCAL_AGENT_TASK_TIMEOUT_MS=900000
LOCAL_AGENT_HEARTBEAT_INTERVAL_MS=15000
LOCAL_AGENT_OFFLINE_AFTER_SECONDS=45
LOCAL_AGENT_TRANSCRIPT_BATCH_MS=400
LOCAL_AGENT_PROTOCOL_VERSION=1
# Production Agent uses a dedicated env file and immutable image tags. Keep
# these values out of the repository test .env.
# XIAOGU_AGENT_ENV_FILE=/Users/you/.config/xiaogu-agent/prod.env
# LOCAL_AGENT_IMAGE=xiaogu/local-agent:<release-git-sha>
# LOCAL_AGENT_TRANSCRIBER_IMAGE=xiaogu/transcriber:<release-git-sha>
# LOCAL_AGENT_WX_CHANNEL_IMAGE=xiaogu/wx-channel:<release-git-sha>
# Video Channel share-link inspection follows wx_channels_download's public parser flow.
# Override with a self-hosted compatible endpoint when available.
# Recommended local companion service: wx_channels_download API, normally http://127.0.0.1:2022.
# It keeps WeChat/Yuanbao login state on the local machine and exposes GET /api/channels/parse_sph.
# VIRAL_WECHAT_LOCAL_API_BASE=http://127.0.0.1:2022
# Docker deployment: Chromium runs in the app container and keeps the Yuanbao session in its named volume.
# Visit http://localhost:6080/vnc.html, log in to Yuanbao there, then use the video link in the app.
VIRAL_WECHAT_CONTAINER_BROWSER_ENABLED=1
VIRAL_WECHAT_BROWSER_PROFILE_DIR=/data/wechat-profile
# Enable the self-hosted Linux Video Channels discovery adapter. It runs the
# MIT-licensed wx_channel source locally and uses the logged-in container browser.
VIRAL_WECHAT_DISCOVERY_ENABLED=1
VIRAL_WECHAT_DISCOVERY_API_BASE=http://wx-channel:2026
VIRAL_WECHAT_DISCOVERY_QUERIES=保险,保险理赔,健康告知,养老规划
VIRAL_WECHAT_DISCOVERY_MAX_ACCOUNTS=3
VIRAL_WECHAT_DISCOVERY_MAX_WORKS=3
VIRAL_WECHAT_DISCOVERY_TIMEOUT_MS=12000
# Comma/newline-separated public Video Channels share URLs. Each link is
# collected only after the logged-in container session returns work metadata.
# VIRAL_WECHAT_CHANNEL_SOURCE_URLS=https://weixin.qq.com/sph/your-public-share-link
VNC_BIND_ADDRESS=127.0.0.1
# VIRAL_WECHAT_CDP_URL=http://127.0.0.1:9222
# CONTAINER_BROWSER_START_URL=https://yuanbao.tencent.com/
# VIRAL_WECHAT_INSPECT_API_BASE=https://sph.litao.workers.dev/api/fetch_video_profile
# VIRAL_WECHAT_INSPECT_TIMEOUT_MS=30000
# VIRAL_XHS_INSPECT_API_BASE=http://localhost:5556
# VIRAL_XHS_INSPECT_TIMEOUT_MS=30000
# Dedicated persistent browser for Xiaohongshu discovery. Open the noVNC page
# on port 6080 once to sign in; its session is isolated from Douyin/Video Channels.
VIRAL_XHS_BROWSER_ENABLED=1
VIRAL_XHS_CDP_URL=http://127.0.0.1:9223
VIRAL_XHS_CDP_PORT=9223
VIRAL_XHS_BROWSER_PROFILE_DIR=/data/xhs-profile
# Dedicated Douyin browser. Video Channels uses 9222 and Xiaohongshu uses 9223.
VIRAL_DOUYIN_BROWSER_ENABLED=1
VIRAL_DOUYIN_CDP_PORT=9224
VIRAL_DOUYIN_BROWSER_PROFILE_DIR=/data/douyin-profile

# Optional native macOS Douyin verifier bridge used only by the local Agent's
# douyin.deep_verify capability. The Docker agent calls POST /verify and GET
# /health on this host-local API; the bridge invokes macOS Accessibility APIs
# against the signed-in Douyin app and returns canonical_url, published_at,
# like_count, and filter_evidence. Downloads/transcription do not start until
# like_count > 1000.
# DOUYIN_NATIVE_VERIFY_API_BASE=http://host.docker.internal:9124
# VIRAL_DOUYIN_DEEP_VERIFY_LIMIT=3
# Dedicated free Sogou WeChat browser. If an anti-bot verification page is
# shown, complete it once through the localhost-only noVNC maintenance page.
VIRAL_SOGOU_BROWSER_ENABLED=1
VIRAL_SOGOU_CDP_URL=http://127.0.0.1:9225
VIRAL_SOGOU_CDP_PORT=9225
VIRAL_SOGOU_BROWSER_PROFILE_DIR=/data/sogou-profile
# Both upstream projects are bundled into the main application image. WeRSS
# keeps its UI, QR authorization, subscriptions and API on localhost:8001;
# WechatSogou exposes its complete public Python API on localhost:8010.
VIRAL_WECHATSOGOU_ENABLED=1
VIRAL_WECHATSOGOU_API_BASE=http://127.0.0.1:8010
VIRAL_WECHATSOGOU_MAX_PAGES=2
WECHATSOGOU_TIMEOUT_SECONDS=12
WECHATSOGOU_CAPTCHA_RETRIES=1
WECHATSOGOU_BIND_ADDRESS=127.0.0.1
VIRAL_WERSS_ENABLED=1
VIRAL_WERSS_API_BASE=http://127.0.0.1:8001
# Create an Access Key in WeRSS and set: AK-SK <access_key>:<secret_key>
VIRAL_WERSS_AUTHORIZATION=
VIRAL_WECHAT_PROVIDER_TIMEOUT_MS=12000
VIRAL_WECHAT_PROVIDER_ARTICLE_LIMIT=30
WERSS_USERNAME=admin
WERSS_PASSWORD=replace-with-a-strong-password
WERSS_ENABLED=1
WERSS_BIND_ADDRESS=127.0.0.1
WERSS_GATHER_CONTENT=True
WERSS_GATHER_MODEL=app

# Billing
OPENMETER_BASE_URL=http://localhost:8888
OPENMETER_API_KEY=
OPENMETER_NAMESPACE=insurance-content-agent
OPENMETER_FEATURE_KEY=ai_content_generation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CREDIT_NOTIFICATION_SECRET=replace-with-a-long-random-secret

# Production database placeholders
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_content_agent
REDIS_URL=redis://localhost:6379
# Docker 内置 Whisper 转写服务（默认启用，无需转写 API Key）
# `next dev` 在宿主机运行时使用回环地址；Docker 内的 app 使用下方的内部地址。
VIRAL_TRANSCRIBE_API_BASE=http://127.0.0.1:8000
VIRAL_TRANSCRIBE_DOCKER_API_BASE=http://transcriber:8000
VIRAL_TRANSCRIBER_PORT=8000
WHISPER_MODEL=small
